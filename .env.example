# Escolha UMA das formas abaixo. Nunca envie este arquivo preenchido ao Git.

# Opção recomendada para Vercel: URL completa de conexão MySQL.
# DATABASE_URL=mysql://USUARIO:SENHA@HOST_PUBLICO:3306/NOME_DO_BANCO

# Alternativa: variáveis separadas (mantém compatibilidade com o ambiente local).
DB_HOST=seu-host-publico-do-mysql
DB_PORT=3306
DB_USER=seu-usuario
DB_PASSWORD=sua-senha
DB_DATABASE=smartpath

# Opcional: caminho para uma autoridade certificadora caso o provedor a exija.
# DB_SSL_CA=/caminho/para/ca.pem
